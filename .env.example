# ── AI providers ────────────────────────────────────────────────
# Gemini API key (https://aistudio.google.com/apikey) — suspect agents + case generation
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CASE_MODEL=gemini-2.5-pro

# ElevenLabs (https://elevenlabs.io) — suspect voices
ELEVENLABS_API_KEY=

# ── Auth (Clerk) ────────────────────────────────────────────────
# Leave DEV_AUTH_BYPASS=true for local dev — no Clerk account needed.
# To enable Google Sign-In: create a Clerk app, set both keys, set bypass to false.
DEV_AUTH_BYPASS=true
CLERK_JWKS_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# ── Infrastructure ──────────────────────────────────────────────
# In Docker these are overridden by docker-compose.yml; used for bare-metal runs.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=investigator_game
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
