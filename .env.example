# ── AI providers ────────────────────────────────────────────────
# Gemini API key (https://aistudio.google.com/apikey) — suspect agents + case generation
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CASE_MODEL=gemini-2.5-pro

# ElevenLabs (https://elevenlabs.io) — suspect voices
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MASCULINE_VOICE_IDS=pNInz6obpgDQGcFmaJgB,ErXwobaYiN019PkySvjV,TxGEqnHWrfWFTfGW9XjX,VR6AewLTigWG4xSOukaG
ELEVENLABS_FEMININE_VOICE_IDS=21m00Tcm4TlvDq8ikWAM,AZnzlk1XvdvUeBnXmlld,EXAVITQu4vr4xnSDxMaL,MF3mGyEYCl7XYWbV9V6O
ELEVENLABS_OUTPUT_AUDIO_FORMAT=pcm_16000
ELEVENLABS_TURN_EAGERNESS=eager
ELEVENLABS_TURN_TIMEOUT_SECONDS=7
ELEVENLABS_SESSION_MAX_SECONDS=900
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY_BOOST=0.75
# Public HTTPS address of the backend. ElevenLabs must reach its WSS endpoint.
# For local development, use an HTTPS tunnel such as https://abc123.ngrok.app.
PUBLIC_BACKEND_URL=

# Replicate (https://replicate.com/account/api-tokens) — image generation
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# ── Media storage ───────────────────────────────────────────────
# Generated images/video are re-hosted here so the URL stays alive after the
# generation provider's own (often temporary) URL expires. Swappable: add a
# new backend/app/services/storage/*_storage.py implementing ImageStorage and
# a branch in get_storage(), then point STORAGE_PROVIDER at it.
STORAGE_PROVIDER=cloudinary
# Cloudinary dashboard → API keys (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auth (Clerk) ────────────────────────────────────────────────
# Leave DEV_AUTH_BYPASS=true to run without Clerk (guest mode, no keys needed).
# To enable Google Sign-In:
#   1. `clerk auth login && cd frontend && clerk env pull` — writes
#      VITE_CLERK_PUBLISHABLE_KEY to frontend/.env.local (gitignored).
#   2. Set DEV_AUTH_BYPASS=false and CLERK_JWKS_URL below (from the Clerk
#      dashboard → API keys → Frontend API, + /.well-known/jwks.json).
DEV_AUTH_BYPASS=true
CLERK_JWKS_URL=
# Optional but recommended with Clerk: the JWT issuer (Clerk Frontend API
# origin, e.g. https://your-app.clerk.accounts.dev). Enforced when set.
CLERK_ISSUER=

# development | production. Production refuses to boot with DEV_AUTH_BYPASS=true.
ENVIRONMENT=development

# ── Gameplay ────────────────────────────────────────────────────
# The commission always keeps this many open cases; solved ones are replaced
# by background Gemini generation.
CASE_POOL_SIZE=3
# Case-generation shape. Changes apply to newly generated cases only.
CASE_MIN_SUSPECTS=3
CASE_MAX_SUSPECTS=5
CASE_MIN_EVIDENCE=4
CASE_MAX_EVIDENCE=6

# ── Infrastructure ──────────────────────────────────────────────
# In Docker these are overridden by docker-compose.yml; used for bare-metal runs.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=investigator_game
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
